{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MkDocs: Serve",
      "type": "shell",
      "command": "command -v mkdocs >/dev/null 2>&1 && mkdocs serve || /Users/andrew/miniforge3/bin/mkdocs serve",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "MkDocs: Open Preview",
      "type": "shell",
      "command": "echo ${input:openMkdocsPreview}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "echo": false,
        "panel": "shared"
      }
    },
    {
      "label": "MkDocs: Serve & Preview",
      "dependsOn": [
        "MkDocs: Serve",
        "MkDocs: Open Preview"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openMkdocsPreview",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": ["http://127.0.0.1:8000"]
    }
  ]
}
