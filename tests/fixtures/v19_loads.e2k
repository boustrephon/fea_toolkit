$ File C:\ETABS\v19_loads.EDB saved 1/1/24 12:00:00

$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "19.1.0"

$ CONTROLS
  UNITS  "KN"  "M"

$ MATERIAL PROPERTIES
  MATERIAL  "STEEL"  M 7.85  W 77.0  TYPE "ISOTROPIC"  E 2.0E+08  U 0.3  A 1.17E-05
  MATERIAL  "STEEL"  DESIGNTYPE "STEEL"  FY 345000  FU 448000

$ FRAME SECTIONS
  FRAMESECTION  "Beam"  MATERIAL "STEEL"  SHAPE "Rectangular"  D 0.4  B 0.3

$ WALL/SLAB/DECK PROPERTIES
  SHELLPROP  "Slab"  MATERIAL "STEEL"  PROPTYPE "SLAB"  TYPE "SHELL"  TM 0.2  TB 0.2

$ STORIES - IN SEQUENCE FROM TOP
  STORY "ROOF"  HEIGHT 3
  STORY "BASE"  ELEV 0

$ POINT COORDINATES
  POINT "1"  0 0
  POINT "2"  0 4
  POINT "3"  4 0
  POINT "4"  4 4

$ LINE CONNECTIVITIES
  LINE  "B1"  BEAM  "1"  "2"  0

$ AREA CONNECTIVITIES
  AREA "S1"  FLOOR  4  "1"  "2"  "4"  "3"  0  0  0  0
  AREA "S2"  FLOOR  4  "1"  "2"  "4"  "3"  0  0  0  0

$ POINT ASSIGNS
  POINTASSIGN  "1"  "BASE"  RESTRAINT "UX UY UZ"
  POINTASSIGN  "2"  "BASE"  RESTRAINT "UX UY UZ"

$ LINE ASSIGNS
  LINEASSIGN  "B1"  "ROOF"  SECTION "Beam"

$ AREA ASSIGNS
  AREAASSIGN  "S1"  "ROOF"  SECTION "Slab"
  AREAASSIGN  "S2"  "ROOF"  SECTION "Slab"

$ LOAD PATTERNS
  LOADPATTERN "DL"  TYPE  "Dead"  SELFWEIGHT  1
  LOADPATTERN "LL"  TYPE  "Live"  SELFWEIGHT  0
  LOADPATTERN "EQ"  TYPE  "Seismic"  SELFWEIGHT  0
  SEISMIC "EQ"  "User Loads"
  SEISMIC "EQ"  USERLOAD  SET 1  "ROOF"  "D1"  FX 50  ECC 0.05

$ FRAME OBJECT LOADS
  LINELOAD  "B1"  "ROOF"  TYPE "UNIFF"  DIR "GRAV"  LC "DL"  FVAL 0.7

$ SHELL UNIFORM LOAD SETS
  SHELLUNIFORMLOADSET "GravitySet"  LOADPAT "DL"  VALUE 1.5
  SHELLUNIFORMLOADSET "GravitySet"  LOADPAT "LL"  VALUE 2.0
  SHELLUNIFORMLOADSET "RoofSet"  LOADPAT "LL"  VALUE 0.5

$ SHELL OBJECT LOADS
  AREALOAD  "S1"  "ROOF"  TYPE "UNIFF"  DIR "GRAV"  LC "LL"  FVAL 2.5
  AREALOAD  "S2"  "ROOF"  TYPE "UNIFLOADSET"  "GravitySet"

$ MASS SOURCE
  MASSSOURCE  "MsSrc1"  INCLUDEELEMENTS "No"  INCLUDEADDEDMASS "No"  INCLUDELOADS "Yes"  INCLUDEMOVE "No"  INCLUDELATERALMASS "Yes"  INCLUDEVERTICALMASS "No"  LUMPATSTORIES "Yes"  ISDEFAULT "Yes"
  MASSSOURCELOAD  "MsSrc1"  "DL"  1
  MASSSOURCELOAD  "MsSrc1"  "LL"  0.25

$ LOAD CASES
  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"
  LOADCASE "Modal"  MAXMODES  50 MINMODES  1 EIGENTOL  1E-09
  LOADCASE "Dead"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "Dead"  LOADPAT  "DL"  SF  1
  LOADCASE "LL_0.5"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "LL_0.5"  LOADPAT  "LL"  SF  0.5
  LOADCASE "SpecX"  TYPE  "Response Spectrum"  MODALCASE  "Modal"
  LOADCASE "SpecX"  ACCEL  "U1"  FUNC  "FUNC"  SF  1.2

$ LOAD COMBINATIONS
  COMBO "Comb1"  TYPE "Linear Add"
  COMBO "Comb1"  DESIGN "Concrete"  COMBOTYPE "Strength"
  COMBO "Comb1"  LOADCASE "Dead"  SF 1.2
  COMBO "Comb1"  LOADCASE "LL_0.5"  SF 1.6
  COMBO "ENVE"  TYPE "Envelope"
  COMBO "ENVE"  LOADCOMBO "Comb1"  SF 1

$ END OF MODEL FILE
